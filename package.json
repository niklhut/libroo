{
  "name": "librooapp",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "build:cloudflare": "NUXT_LIBROO_RUNTIME_PROFILE=cloudflare NITRO_PRESET=cloudflare_module nuxt build",
    "build:selfhost": "NUXT_LIBROO_RUNTIME_PROFILE=selfhost NITRO_PRESET=node_server nuxt build",
    "backup:selfhost": "node scripts/backup-selfhost.mjs",
    "restore:selfhost": "node scripts/restore-selfhost.mjs",
    "backup:hosted:manifest": "node scripts/hosted-backup-manifest.mjs",
    "check:cloudflare-size": "pnpm build:cloudflare && pnpm exec wrangler --cwd .output deploy --dry-run --outdir /tmp/libroo-wrangler-dry-run",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "test": "vitest run --project unit --project d1 --project integration --project scripts",
    "test:unit": "vitest run --project unit",
    "test:d1": "vitest run --project d1",
    "test:integration": "vitest run --project integration",
    "test:scripts": "vitest run --project scripts",
    "test:e2e": "pnpm build:selfhost && playwright test",
    "test:e2e:run": "playwright test",
    "test:e2e:ui": "pnpm build:selfhost && playwright test --ui"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.6.26",
    "@comark/nuxt": "^0.6.2",
    "@effect/platform": "^0.97.1",
    "@effect/platform-node": "^0.108.1",
    "@iconify-json/lucide": "^1.2.122",
    "@iconify-json/simple-icons": "^1.2.93",
    "@libsql/client": "^0.17.4",
    "@nuxt/hints": "1.1.4",
    "@nuxt/image": "2.1.0",
    "@nuxt/scripts": "1.3.3",
    "@nuxt/ui": "^4.10.0",
    "@nuxthub/core": "^0.10.8",
    "@nuxtjs/turnstile": "^1.1.3",
    "@pinia/nuxt": "^1.0.2",
    "@unhead/vue": "^3.3.1",
    "better-auth": "^1.6.26",
    "comark": "0.6.2",
    "drizzle-orm": "^0.45.2",
    "effect": "^3.22.1",
    "h3": "1.15.11",
    "jose": "^6.2.8",
    "nodemailer": "^9.0.5",
    "nuxt": "^4.5.2",
    "pinia": "^4.0.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.35.3",
    "vue": "^3.5.41",
    "vue-qrcode-reader": "^5.7.3",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@libsql/linux-arm64-musl": "0.5.29",
    "@libsql/linux-x64-musl": "0.5.29"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.20.3",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.1.0",
    "@playwright/test": "^1.62.1",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9",
    "wrangler": "4.120.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
