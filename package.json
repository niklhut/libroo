{
  "name": "librooapp",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "build:cloudflare": "NUXT_LIBROO_RUNTIME_PROFILE=cloudflare NITRO_PRESET=cloudflare_module nuxt build",
    "build:selfhost": "NUXT_LIBROO_RUNTIME_PROFILE=selfhost NITRO_PRESET=node_server nuxt build",
    "backup:selfhost": "node scripts/backup-selfhost.mjs",
    "restore:selfhost": "node scripts/restore-selfhost.mjs",
    "backup:hosted:manifest": "node scripts/hosted-backup-manifest.mjs",
    "check:cloudflare-size": "pnpm build:cloudflare && pnpm exec wrangler --cwd .output deploy --dry-run --outdir /tmp/libroo-wrangler-dry-run",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "test": "vitest run --project unit --project d1 --project integration --project scripts",
    "test:unit": "vitest run --project unit",
    "test:d1": "vitest run --project d1",
    "test:integration": "vitest run --project integration",
    "test:scripts": "vitest run --project scripts",
    "test:e2e": "pnpm build:selfhost && playwright test",
    "test:e2e:run": "playwright test",
    "test:e2e:ui": "pnpm build:selfhost && playwright test --ui"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.10",
    "@comark/nuxt": "^0.7.0",
    "@effect/platform": "^0.97.2",
    "@effect/platform-node": "^0.108.2",
    "@iconify-json/lucide": "^1.2.145",
    "@iconify-json/simple-icons": "^1.2.100",
    "@libsql/client": "^0.18.0",
    "@nuxt/hints": "1.1.5",
    "@nuxt/image": "2.1.0",
    "@nuxt/scripts": "1.3.12",
    "@nuxt/ui": "^4.12.0",
    "@nuxthub/core": "^0.10.8",
    "@nuxtjs/turnstile": "^1.1.3",
    "@pinia/nuxt": "^1.0.2",
    "@unhead/vue": "^3.4.3",
    "better-auth": "^1.7.10",
    "comark": "0.7.0",
    "drizzle-orm": "^0.45.4",
    "effect": "^3.22.2",
    "h3": "1.15.11",
    "jose": "^6.2.12",
    "nodemailer": "^10.1.2",
    "nuxt": "^4.6.2",
    "pinia": "^4.0.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.35.5",
    "vue": "^3.5.44",
    "vue-qrcode-reader": "^5.7.3",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "@img/sharp-wasm32": "0.35.5",
    "@libsql/linux-arm64-musl": "0.5.29",
    "@libsql/linux-x64-musl": "0.5.29"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.4",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.4",
    "@playwright/test": "^1.64.1",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13",
    "wrangler": "4.151.1"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.14.0"
}
